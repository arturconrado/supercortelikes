generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoStatus {
  UPLOADING
  UPLOADED
  FAILED
}

enum UploadStatus {
  STARTED
  COMPLETED
  FAILED
}

enum PipelineStage {
  INGESTION
  TRANSCRIPTION
  SEGMENTATION
  SCORING
  CLIPS
  CAPTIONS
  COMPOSITION
  RENDERING
  EXPORTS
}

enum PipelineRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum StageExecutionStatus {
  PENDING
  QUEUED
  PROCESSING
  RETRYING
  SUCCEEDED
  FAILED
  DEAD_LETTERED
}

enum DeadLetterStatus {
  OPEN
  REDRIVEN
  DISCARDED
}

enum Plan {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  REVIEWER
  PUBLISHER
  VIEWER
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum ClipStatus {
  SUGGESTED
  APPROVED
  RENDERING
  READY
  REVIEW_REQUIRED
  FAILED
}

enum ExportStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum ExportPurpose {
  PREVIEW
  FINAL
}

enum OpportunityStatus {
  OBSERVING
  TESTING
  ACTIVE
  SCALING
  DECLINING
  MIGRATING
  DEAD
}

enum GateDecision {
  PENDING
  APPROVED
  REJECTED
}

enum DigitalProductStatus {
  DRAFT
  QA_REQUIRED
  READY
  ARCHIVED
}

enum OfferType {
  PRODUCT
  SERVICE
  HYBRID
}

enum BrowserAutomationKind {
  MARKET_RESEARCH
  PRODUCT_SUBMISSION
  CONTENT_SCHEDULING
  COMPETITOR_REVIEW
  CUSTOM
}

enum BrowserAutomationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  REVIEW_REQUIRED
  CANCELLED
}

enum MediaAssetKind {
  LANDING_PAGE
  STATIC_IMAGE
  CAROUSEL
  SHORT_VIDEO
  AUDIO_SCRIPT
  WHATSAPP_COPY
  EMAIL
  DIAGNOSTIC_FORM
  PROPOSAL_PDF
  SERVICE_ONEPAGER
  CHECKOUT_COPY
}

enum MediaAssetStatus {
  DRAFT
  READY
  REVIEW_REQUIRED
  APPROVED
  ARCHIVED
}

enum OfferLaunchStatus {
  DRAFT
  READY
  RUNNING
  REVIEW_REQUIRED
  COMPLETED
  FAILED
}

enum OfferPublicationStatus {
  DRAFT
  READY
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
}

enum OfferProductionStageName {
  OFFER
  MEDIA_ASSETS
  PUBLICATION_DRAFTS
  METRICS_SETUP
}

model User {
  id                      String               @id @default(uuid()) @db.Uuid
  email                   String               @unique
  passwordHash            String
  displayName             String
  emailVerifiedAt         DateTime?
  acceptedTermsVersion    String?
  acceptedPrivacyVersion  String?
  termsAcceptedAt         DateTime?
  privacyAcceptedAt       DateTime?
  notificationPreferences Json?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  ownedWorkspaces         Workspace[]          @relation("WorkspaceOwner")
  memberships             WorkspaceMember[]
  projects                Project[]
  videos                  Video[]
  opportunities           MarketOpportunity[]
  browserAutomationRuns   BrowserAutomationRun[]
  refreshSessions         RefreshSession[]
  passwordResets          PasswordResetToken[]
  emailVerifications      EmailVerificationToken[]
  auditLogs               AuditLog[]
  productEvents           ProductEvent[]

  @@map("users")
}

model Workspace {
  id            String            @id @default(uuid()) @db.Uuid
  ownerId       String            @db.Uuid
  name          String
  slug          String            @unique
  plan          Plan              @default(FREE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  owner         User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members       WorkspaceMember[]
  projects      Project[]
  videos        Video[]
  brandKits     BrandKit[]
  subscriptions Subscription[]
  billingCheckouts BillingCheckout[]
  creditTopUps  CreditTopUp[]
  publications  Publication[]
  socialConnections SocialConnection[]
  opportunities MarketOpportunity[]
  digitalProducts DigitalProduct[]
  mediaAssets OfferMediaAsset[]
  offerLaunchRuns OfferLaunchRun[]
  offerPublicationDrafts OfferPublicationDraft[]
  offerMetricSnapshots OfferMetricSnapshot[]
  browserAutomationRuns BrowserAutomationRun[]
  usageEvents   UsageEvent[]
  auditLogs     AuditLog[]
  productEvents ProductEvent[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(EDITOR)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  createdById String    @db.Uuid
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  videos      Video[]

  @@index([workspaceId, updatedAt])
  @@map("projects")
}

model MarketOpportunity {
  id                String              @id @default(uuid()) @db.Uuid
  workspaceId       String              @db.Uuid
  createdById       String              @db.Uuid
  title             String
  audience          String
  pain              String
  category          String
  format            String
  offerType         OfferType           @default(PRODUCT)
  status            OpportunityStatus   @default(OBSERVING)
  gateDecision      GateDecision        @default(PENDING)
  score             Int
  demandScore       Int
  saturationScore   Int
  monetizationScore Int
  channelFitScore   Int
  evidenceSummary   String
  agentRationale    String
  nextAction        String
  sourceTags        Json
  recommendedMedia  Json
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  approvedAt        DateTime?
  rejectedAt        DateTime?
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy         User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  signals           OpportunitySignal[]
  products          DigitalProduct[]
  launchRuns        OfferLaunchRun[]
  metricSnapshots   OfferMetricSnapshot[]
  browserAutomationRuns BrowserAutomationRun[]

  @@index([workspaceId, status, score])
  @@index([workspaceId, gateDecision, updatedAt])
  @@map("market_opportunities")
}

model BrowserAutomationRun {
  id             String                  @id @default(uuid()) @db.Uuid
  workspaceId    String                  @db.Uuid
  createdById    String                  @db.Uuid
  opportunityId  String?                 @db.Uuid
  kind           BrowserAutomationKind
  status         BrowserAutomationStatus @default(QUEUED)
  provider       String
  targetUrl      String
  goal           String
  allowedActions Json
  blockedActions Json
  steps          Json
  result         Json?
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  workspace      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  opportunity    MarketOpportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
  @@index([opportunityId, createdAt])
  @@map("browser_automation_runs")
}

model OpportunitySignal {
  id            String            @id @default(uuid()) @db.Uuid
  opportunityId String            @db.Uuid
  source        String
  label         String
  strength      Int
  url           String?
  capturedAt    DateTime          @default(now())
  metadata      Json?
  opportunity   MarketOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, strength])
  @@map("opportunity_signals")
}

model DigitalProduct {
  id            String               @id @default(uuid()) @db.Uuid
  workspaceId   String               @db.Uuid
  opportunityId String               @db.Uuid
  title         String
  format        String
  offerType     OfferType            @default(PRODUCT)
  status        DigitalProductStatus @default(DRAFT)
  priceCents    Int                  @default(1900)
  qualityScore  Int                  @default(0)
  outline       Json
  serviceBlueprint Json?
  mediaPlan     Json
  assets        Json
  qaFindings    Json
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunity   MarketOpportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  mediaAssets   OfferMediaAsset[]
  launchRuns    OfferLaunchRun[]
  publicationDrafts OfferPublicationDraft[]
  metricSnapshots OfferMetricSnapshot[]

  @@index([workspaceId, status, updatedAt])
  @@index([opportunityId, createdAt])
  @@map("digital_products")
}

model OfferLaunchRun {
  id            String            @id @default(uuid()) @db.Uuid
  workspaceId   String            @db.Uuid
  opportunityId String            @db.Uuid
  productId     String            @db.Uuid
  status        OfferLaunchStatus @default(DRAFT)
  mode          String            @default("manual")
  steps         Json
  result        Json?
  errorMessage  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunity   MarketOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  product       DigitalProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  stages        OfferProductionStageExecution[]
  outboxEvents  OfferProductionOutboxEvent[]

  @@index([workspaceId, status, createdAt])
  @@index([opportunityId, createdAt])
  @@map("offer_launch_runs")
}

model OfferProductionOutboxEvent {
  id          String         @id @default(uuid()) @db.Uuid
  launchRunId String         @db.Uuid
  type        String
  payload     Json
  attempts    Int            @default(0)
  availableAt DateTime       @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  publishedAt DateTime?
  lastError   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  launchRun   OfferLaunchRun @relation(fields: [launchRunId], references: [id], onDelete: Cascade)

  @@index([publishedAt, availableAt, createdAt])
  @@index([launchRunId, createdAt])
  @@map("offer_production_outbox_events")
}

model OfferProductionStageExecution {
  id           String                   @id @default(uuid()) @db.Uuid
  launchRunId  String                   @db.Uuid
  stage        OfferProductionStageName
  status       StageExecutionStatus     @default(PENDING)
  attempts     Int                      @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  errorCode    String?
  errorMessage String?
  output       Json?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  launchRun    OfferLaunchRun           @relation(fields: [launchRunId], references: [id], onDelete: Cascade)

  @@unique([launchRunId, stage])
  @@index([status, updatedAt])
  @@map("offer_production_stage_executions")
}

model OfferPublicationDraft {
  id          String                 @id @default(uuid()) @db.Uuid
  workspaceId String                 @db.Uuid
  productId   String                 @db.Uuid
  provider    String
  channel     String
  status      OfferPublicationStatus @default(DRAFT)
  title       String
  body        Json
  scheduledAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product     DigitalProduct         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
  @@index([productId, channel])
  @@map("offer_publication_drafts")
}

model OfferMetricSnapshot {
  id            String            @id @default(uuid()) @db.Uuid
  workspaceId   String            @db.Uuid
  opportunityId String            @db.Uuid
  productId     String?           @db.Uuid
  source        String
  impressions   Int               @default(0)
  clicks        Int               @default(0)
  leads         Int               @default(0)
  sales         Int               @default(0)
  revenueCents  Int               @default(0)
  costCents     Int               @default(0)
  capturedAt    DateTime          @default(now())
  metadata      Json?
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunity   MarketOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  product       DigitalProduct?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([workspaceId, capturedAt])
  @@index([opportunityId, capturedAt])
  @@map("offer_metric_snapshots")
}

model OfferMediaAsset {
  id            String           @id @default(uuid()) @db.Uuid
  workspaceId   String           @db.Uuid
  productId     String           @db.Uuid
  kind          MediaAssetKind
  status        MediaAssetStatus @default(DRAFT)
  title         String
  channel       String
  objective     String
  brief         String
  body          Json
  qaChecklist   Json
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product       DigitalProduct   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind, status])
  @@index([productId, kind])
  @@map("offer_media_assets")
}

model Video {
  id               String          @id @default(uuid()) @db.Uuid
  originalFilename String
  title            String?
  storageKey       String          @unique
  sourceUrl        String?
  storageBucket    String
  mimeType         String
  container        String
  sizeBytes        BigInt?
  checksumSha256   String?
  storageEtag      String?
  thumbnailKey     String?
  burnedInSubtitlesDetected Boolean @default(false)
  burnedInSubtitlesConfidence Float?
  durationMs       BigInt?
  processingOptions Json?
  width            Int?
  height           Int?
  frameRate        Float?
  videoCodec       String?
  audioCodec       String?
  status           VideoStatus     @default(UPLOADING)
  failureCode      String?
  failureMessage   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  workspaceId      String?         @db.Uuid
  ownerId          String?         @db.Uuid
  projectId        String?         @db.Uuid
  uploads          UploadAttempt[]
  pipelineRuns     PipelineRun[]
  workspace        Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  owner            User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  transcript       Transcript?
  segments         Segment[]
  clips            Clip[]
  usageEvents      UsageEvent[]

  @@index([status, createdAt])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, status, createdAt])
  @@index([projectId, createdAt])
  @@map("videos")
}

model UploadAttempt {
  id                String       @id @default(uuid()) @db.Uuid
  videoId           String       @db.Uuid
  idempotencyKey    String       @unique @db.VarChar(128)
  providerUploadId  String?      @unique
  expectedSizeBytes BigInt?
  expectedMimeType  String?
  expiresAt         DateTime?
  status            UploadStatus @default(STARTED)
  bytesReceived     BigInt       @default(0)
  failureCode       String?
  startedAt         DateTime     @default(now())
  completedAt       DateTime?
  video             Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([status, startedAt])
  @@map("upload_attempts")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  aggregateId String    @db.Uuid
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?

  @@index([publishedAt, availableAt, createdAt])
  @@index([publishedAt, lockedAt, availableAt, createdAt])
  @@map("outbox_events")
}

model PipelineRun {
  id             String            @id @default(uuid()) @db.Uuid
  videoId        String            @db.Uuid
  sourceEventId  String            @unique @db.Uuid
  status         PipelineRunStatus @default(PENDING)
  currentStage   PipelineStage?
  startedAt      DateTime?
  completedAt    DateTime?
  failureCode    String?
  failureMessage String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  video          Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  stages         StageExecution[]
  deadLetters    DeadLetterJob[]

  @@index([status, createdAt])
  @@index([videoId, createdAt])
  @@index([videoId, status, createdAt])
  @@index([status, currentStage, createdAt])
  @@map("pipeline_runs")
}

model StageExecution {
  id            String               @id @default(uuid()) @db.Uuid
  pipelineRunId String               @db.Uuid
  stage         PipelineStage
  status        StageExecutionStatus @default(PENDING)
  jobId         String               @unique
  attempts      Int                  @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  errorCode     String?
  errorMessage  String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  pipelineRun   PipelineRun          @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
  deadLetters   DeadLetterJob[]

  @@unique([pipelineRunId, stage])
  @@index([status, updatedAt])
  @@index([pipelineRunId, status, updatedAt])
  @@map("stage_executions")
}

model DeadLetterJob {
  id               String           @id @default(uuid()) @db.Uuid
  pipelineRunId    String?          @db.Uuid
  stageExecutionId String?          @db.Uuid
  originalQueue    String
  originalJobId    String
  safePayload      Json
  errorCode        String
  errorMessage     String
  attempts         Int
  status           DeadLetterStatus @default(OPEN)
  redriveCount     Int              @default(0)
  createdAt        DateTime         @default(now())
  resolvedAt       DateTime?
  pipelineRun      PipelineRun?     @relation(fields: [pipelineRunId], references: [id], onDelete: SetNull)
  stageExecution   StageExecution?  @relation(fields: [stageExecutionId], references: [id], onDelete: SetNull)

  @@unique([originalQueue, originalJobId])
  @@index([status, createdAt])
  @@index([pipelineRunId, status, createdAt])
  @@map("dead_letter_jobs")
}

model Transcript {
  id         String   @id @default(uuid()) @db.Uuid
  videoId    String   @unique @db.Uuid
  language   String
  confidence Float
  fullText   String
  words      Json
  speakers   Json
  durationMs BigInt
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("transcripts")
}

model Segment {
  id         String      @id @default(uuid()) @db.Uuid
  videoId    String      @db.Uuid
  startMs    BigInt
  endMs      BigInt
  text       String
  speaker    String?
  topic      String?
  emotion    String?
  confidence Float
  createdAt  DateTime    @default(now())
  video      Video       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  viralScore ViralScore?
  clips      Clip[]

  @@index([videoId, startMs])
  @@map("segments")
}

model ViralScore {
  id            String   @id @default(uuid()) @db.Uuid
  segmentId     String   @unique @db.Uuid
  curiosity     Float
  authority     Float
  controversy   Float
  emotion       Float
  business      Float
  entertainment Float
  educational   Float
  financial     Float
  finalScore    Float
  explanation   String
  createdAt     DateTime @default(now())
  segment       Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@index([finalScore])
  @@map("viral_scores")
}

model Clip {
  id               String         @id @default(uuid()) @db.Uuid
  videoId          String         @db.Uuid
  segmentId        String?        @db.Uuid
  startMs          BigInt
  endMs            BigInt
  score            Float
  title            String?
  titleSuggestions Json
  reason           String
  genre            String?
  hook             String?
  sourceText       String?
  aspectRatio      String         @default("9:16")
  thumbnailKey     String?
  status           ClipStatus     @default(SUGGESTED)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  video            Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  segment          Segment?       @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  captions         CaptionTrack[]
  composition      ClipComposition?
  exports          Export[]
  publications     Publication[]
  seo              SeoMetadata?

  @@index([videoId, score])
  @@index([videoId, status, createdAt])
  @@map("clips")
}

model ClipComposition {
  id          String   @id @default(uuid()) @db.Uuid
  clipId      String   @unique @db.Uuid
  version     String
  plan        Json
  diagnostics Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clip        Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@map("clip_compositions")
}

model CaptionTrack {
  id        String   @id @default(uuid()) @db.Uuid
  clipId    String   @db.Uuid
  template  String
  language  String
  srtKey    String?
  assKey    String?
  cues      Json
  editedCues Json?
  style     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clip      Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([clipId])
  @@map("caption_tracks")
}

model Export {
  id          String       @id @default(uuid()) @db.Uuid
  clipId      String       @db.Uuid
  format      String
  purpose     ExportPurpose @default(FINAL)
  aspectRatio String
  storageKey  String?
  sizeBytes   BigInt?
  renderFingerprint String?
  sourcePipelineRunId String?     @db.Uuid
  status      ExportStatus @default(QUEUED)
  errorCode   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  clip        Clip         @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@index([clipId, status])
  @@index([clipId, purpose, status])
  @@index([clipId, renderFingerprint, status])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@map("exports")
}

model SeoMetadata {
  id          String   @id @default(uuid()) @db.Uuid
  clipId      String   @unique @db.Uuid
  titles      Json
  ctrScores   Json
  description String
  hashtags    Json
  keywords    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clip        Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@map("seo_metadata")
}

model BrandKit {
  id           String    @id @default(uuid()) @db.Uuid
  workspaceId  String    @db.Uuid
  name         String
  logoKey      String?
  fontFamily   String?
  primaryColor String
  accentColor  String
  watermark    Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("brand_kits")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  workspaceId            String             @db.Uuid
  plan                   Plan
  status                 SubscriptionStatus @default(PENDING)
  provider               String             @default("mercado_pago")
  providerSubscriptionId String?            @unique
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  workspace              Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("subscriptions")
}

model BillingCheckout {
  id                 String   @id @default(uuid()) @db.Uuid
  workspaceId        String   @db.Uuid
  idempotencyKey     String   @unique @db.VarChar(128)
  plan               Plan
  method             String
  provider           String   @default("mercado_pago")
  providerResourceId String?
  status             String
  response           Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("billing_checkouts")
}

model CreditTopUp {
  id                 String    @id @default(uuid()) @db.Uuid
  workspaceId        String    @db.Uuid
  idempotencyKey     String    @unique @db.VarChar(128)
  minutes            Int
  amountCents        Int
  currency           String    @default("BRL")
  provider           String    @default("mercado_pago")
  providerResourceId String?   @unique
  status             String
  response           Json
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
  @@map("credit_top_ups")
}

model BillingWebhookEvent {
  id                 String    @id @default(uuid()) @db.Uuid
  provider           String    @default("mercado_pago")
  providerEventId    String    @unique
  providerResourceId String
  eventType          String
  status             String
  processedAt        DateTime?
  receivedAt         DateTime  @default(now())
  payload            Json?
  lastError          String?

  @@index([status, receivedAt])
  @@map("billing_webhook_events")
}

model UsageEvent {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  videoId     String?   @db.Uuid
  idempotencyKey String? @unique @db.VarChar(160)
  type        String
  quantity    Decimal   @db.Decimal(18, 4)
  unit        String
  costCents   Int       @default(0)
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  video       Video?    @relation(fields: [videoId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([type, createdAt])
  @@map("usage_events")
}

model Publication {
  id             String     @id @default(uuid()) @db.Uuid
  workspaceId    String     @db.Uuid
  clipId         String?    @db.Uuid
  provider       String
  status         String     @default("DRAFT")
  scheduledAt    DateTime?
  title          String
  description    String?
  hashtags       Json?
  providerPostId String?
  errorMessage   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  workspace      Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clip           Clip?      @relation(fields: [clipId], references: [id], onDelete: SetNull)

  @@index([workspaceId, scheduledAt])
  @@index([provider, status])
  @@map("publications")
}

model SocialConnection {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @db.Uuid
  provider         String
  status           String    @default("PENDING")
  accessTokenHash  String?
  refreshTokenHash String?
  scopes           Json?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId, status])
  @@map("social_connections")
}

model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String?    @db.Uuid
  workspaceId String?    @db.Uuid
  action      String
  resource    String
  resourceId  String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model ProductEvent {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @unique @db.Uuid
  sessionId   String    @db.Uuid
  userId      String    @db.Uuid
  workspaceId String    @db.Uuid
  name        String    @db.VarChar(80)
  route       String?   @db.VarChar(240)
  properties  Json?
  occurredAt  DateTime
  receivedAt  DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, name, occurredAt])
  @@index([userId, occurredAt])
  @@map("product_events")
}
